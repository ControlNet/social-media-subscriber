{
  "$defs": {
    "Platform": {
      "description": "External service where subscribed content is published.",
      "enum": [
        "linkedin",
        "x"
      ],
      "title": "Platform",
      "type": "string"
    },
    "PostIndexEntry": {
      "additionalProperties": false,
      "description": "Public locator and routing metadata for one persisted Post file.",
      "oneOf": [
        {
          "properties": {
            "account_profile_url": {
              "pattern": "^(?:https://www\\.linkedin\\.com/in/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/|https://www\\.linkedin\\.com/company/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/)$"
            },
            "path": {
              "pattern": "^posts/linkedin/[a-f0-9]{64}\\.json$"
            },
            "platform": {
              "const": "linkedin"
            }
          }
        },
        {
          "properties": {
            "account_profile_url": {
              "pattern": "^https://x\\.com/(?!(?:about|compose|download|explore|help|home|i|intent|login|messages|notifications|privacy|search|settings|signup|tos)/)[a-z0-9_]{1,15}/$"
            },
            "path": {
              "pattern": "^posts/x/[a-f0-9]{64}\\.json$"
            },
            "platform": {
              "const": "x"
            }
          }
        }
      ],
      "properties": {
        "account_profile_url": {
          "pattern": "^(?:https://www\\.linkedin\\.com/in/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/|https://www\\.linkedin\\.com/company/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/|https://x\\.com/(?!(?:about|compose|download|explore|help|home|i|intent|login|messages|notifications|privacy|search|settings|signup|tos)/)[a-z0-9_]{1,15}/)$",
          "title": "Account Profile Url",
          "type": "string"
        },
        "path": {
          "pattern": "^posts/(?:linkedin|x)/[a-f0-9]{64}\\.json$",
          "title": "Path",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        }
      },
      "required": [
        "path",
        "account_profile_url",
        "published_at",
        "platform"
      ],
      "title": "PostIndexEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Newest-first complete index of every persisted Post record.",
  "properties": {
    "posts": {
      "items": {
        "$ref": "#/$defs/PostIndexEntry"
      },
      "title": "Posts",
      "type": "array"
    }
  },
  "required": [
    "posts"
  ],
  "title": "PostsIndex",
  "type": "object"
}
