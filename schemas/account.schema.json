{
  "$defs": {
    "AccountKind": {
      "description": "Public identity shape supported by a platform.",
      "enum": [
        "person",
        "company"
      ],
      "title": "AccountKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned provider-neutral Account record persisted at the boundary.",
  "properties": {
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "id": {
      "pattern": "^https://www\\.linkedin\\.com/(?:in|company)/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%(?:[01][0-9A-Fa-f]|7[fF]|2[fF]|5[cC]|2[eE])))[^/\\x00-\\x1f\\x7f]+/$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AccountKind"
    },
    "platform": {
      "const": "linkedin",
      "title": "Platform",
      "type": "string"
    },
    "profile_url": {
      "pattern": "^https://www\\.linkedin\\.com/(?:in|company)/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%(?:[01][0-9A-Fa-f]|7[fF]|2[fF]|5[cC]|2[eE])))[^/\\x00-\\x1f\\x7f]+/$",
      "title": "Profile Url",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "platform",
    "kind",
    "profile_url",
    "first_seen_at"
  ],
  "title": "Account",
  "type": "object"
}
