{
  "$defs": {
    "AccountKind": {
      "description": "Public identity shape supported by a platform.",
      "enum": [
        "person",
        "company"
      ],
      "title": "AccountKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Provider-neutral Account identified by its canonical profile URL.",
  "properties": {
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AccountKind"
    },
    "platform": {
      "const": "linkedin",
      "title": "Platform",
      "type": "string"
    },
    "profile_url": {
      "pattern": "^https://www\\.linkedin\\.com/(?:in|company)/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/$",
      "title": "Profile Url",
      "type": "string"
    }
  },
  "required": [
    "platform",
    "kind",
    "profile_url",
    "first_seen_at"
  ],
  "title": "Account",
  "type": "object"
}
