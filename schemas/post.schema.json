{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Provider-neutral platform Post with open-ended content.",
  "properties": {
    "account_profile_url": {
      "pattern": "^https://www\\.linkedin\\.com/(?:in|company)/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/$",
      "title": "Account Profile Url",
      "type": "string"
    },
    "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
    },
    "content": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Content",
      "type": "object"
    },
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "platform_post_id": {
      "minLength": 1,
      "title": "Platform Post Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "platform_post_id",
    "account_profile_url",
    "canonical_url",
    "published_at",
    "type",
    "content",
    "first_seen_at"
  ],
  "title": "Post",
  "type": "object"
}
