{
  "additionalProperties": false,
  "description": "Versioned provider-neutral original Post persisted at the boundary.",
  "properties": {
    "account_id": {
      "pattern": "^https://www\\.linkedin\\.com/(?:in|company)/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/$",
      "title": "Account Id",
      "type": "string"
    },
    "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "hashtags": {
      "items": {
        "type": "string"
      },
      "title": "Hashtags",
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^linkedin:post:.+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "original",
      "title": "Kind",
      "type": "string"
    },
    "links": {
      "items": {
        "type": "string"
      },
      "title": "Links",
      "type": "array",
      "uniqueItems": true
    },
    "platform_post_id": {
      "minLength": 1,
      "title": "Platform Post Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Text"
    }
  },
  "required": [
    "schema_version",
    "id",
    "platform_post_id",
    "account_id",
    "canonical_url",
    "published_at",
    "text",
    "kind",
    "hashtags",
    "links",
    "first_seen_at",
    "content_hash"
  ],
  "title": "Post",
  "type": "object"
}
