{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Provider-neutral platform Post with open-ended content.",
  "oneOf": [
    {
      "properties": {
        "account_profile_url": {
          "pattern": "^(?:https://www\\.linkedin\\.com/in/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/|https://www\\.linkedin\\.com/company/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/)$"
        },
        "canonical_url": {
          "pattern": "^https://www\\.linkedin\\.com/(?:posts/|feed/update/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*%(?:[01][0-9A-Fa-f]|7[fF]|2[fF]|5[cC]|2[eE]))[^?#\\x00-\\x1f\\x7f\\\\]*$"
        }
      }
    },
    {
      "properties": {
        "account_profile_url": {
          "pattern": "^https://x\\.com/(?!(?:about|compose|download|explore|help|home|i|intent|login|messages|notifications|privacy|search|settings|signup|tos)/)[a-z0-9_]{1,15}/$"
        },
        "canonical_url": {
          "pattern": "^https://x\\.com/(?!(?:about|compose|download|explore|help|home|i|intent|login|messages|notifications|privacy|search|settings|signup|tos)/)[a-z0-9_]{1,15}/status/[1-9][0-9]*$"
        },
        "platform_post_id": {
          "pattern": "^[1-9][0-9]*$"
        }
      }
    }
  ],
  "properties": {
    "account_profile_url": {
      "pattern": "^(?:https://www\\.linkedin\\.com/in/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/|https://www\\.linkedin\\.com/company/(?!\\.{1,2}/)(?![^/]*(?:\\\\|%))[^/?#\\x00-\\x1f\\x7f]+/|https://x\\.com/(?!(?:about|compose|download|explore|help|home|i|intent|login|messages|notifications|privacy|search|settings|signup|tos)/)[a-z0-9_]{1,15}/)$",
      "title": "Account Profile Url",
      "type": "string"
    },
    "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
    },
    "content": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Content",
      "type": "object"
    },
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "platform_post_id": {
      "minLength": 1,
      "title": "Platform Post Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "platform_post_id",
    "account_profile_url",
    "canonical_url",
    "published_at",
    "type",
    "content",
    "first_seen_at"
  ],
  "title": "Post",
  "type": "object"
}
